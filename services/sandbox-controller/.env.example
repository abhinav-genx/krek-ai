AGENT_CONTROLLER_URL=http://localhost:7000
SANDBOX_CONTROLLER_URL=http://localhost:5000
E2B_API_KEY=
JWT_SECRET=

# Cloudflare R2 (S3-compatible) for persisting chat workspaces after each agent
# run. When any of these is unset, snapshot/restore are skipped (no-op) and the
# app keeps working. Create a bucket + API token in the Cloudflare R2 dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: sandbox lifetime (ms) before E2B pauses it. Default 1800000 (30 min).
SANDBOX_TIMEOUT_MS=