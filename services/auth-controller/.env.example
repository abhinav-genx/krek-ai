# MUST match agent-controller & sandbox-controller — used to sign login JWTs.
# Keep exactly ONE JWT_SECRET line; a duplicate makes dotenv pick the first one
# and can silently drift from the other services (every /chat call then 401s).
JWT_SECRET=

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
GITHUB_CLIENT_SECRET=

# Web app origin (used for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Base64 AES key for encrypting the user's GitHub token at rest.
# Generate with: openssl rand -base64 32 (MUST match agent-controller)
GITHUB_TOKEN_ENC_KEY_B64=

# Postgres connection string (this service runs from its own dir under `pnpm dev`,
# so it loads THIS .env, not the root one)
DATABASE_URL=