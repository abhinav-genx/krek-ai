# Port the AI service listens on (defaults to 4000)
PORT=7000

# OpenRouter API key — https://openrouter.ai/keys
OPEN_ROUTER_MODEL=
OPEN_ROUTER_API_KEY=

SANDBOX_CONTROLLER_URL=http://localhost:5000

# Model slug to use (defaults to openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional attribution headers for OpenRouter rankings
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

JWT_SECRET=
