# Port the agent-controller listens on (defaults to 7000)
PORT=7000

# OpenRouter (https://openrouter.ai/keys) — model slug + API key
OPEN_ROUTER_MODEL=openai/gpt-4o-mini
OPEN_ROUTER_API_KEY=

# URL of the sandbox-controller this service drives
SANDBOX_CONTROLLER_URL=http://localhost:5000

# Repo cloned into each sandbox to provide the agent's tools
CRACK_HEAD_REPO_URL=https://github.com/abhinav-genx/crack-head

# MUST match auth-controller & sandbox-controller — used to verify login JWTs
JWT_SECRET=

# Postgres connection string. REQUIRED: under `pnpm dev` this service runs with
# its own directory as CWD, so it loads THIS .env (not the root one). Missing it
# makes every authenticated route return 401 (the DB lookup in the auth
# middleware throws and is caught as "unauthorized user").
DATABASE_URL=

# Base64 AES key used to decrypt the user's stored GitHub token (for cloning
# private repos). MUST match the value used by auth-controller.
GITHUB_TOKEN_ENC_KEY_B64=

# Shared secret sent as x-internal-key to the sandbox-controller. MUST match the
# sandbox-controller's INTERNAL_API_KEY.
INTERNAL_API_KEY=
